{
  "name": "@devpulse-dev/api-types",
  "version": "1.6.0",
  "description": "DevPulse API — TypeScript types generated from the OpenAPI contracts (single package covering the whole /api/v2 surface). Version is auto-synced from the parent pom <revision> by scripts/build-types.mjs — do not bump by hand.",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    },
    "./openapi.json": "./dist/openapi.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-types.mjs",
    "typecheck": "tsc --noEmit --strict dist/index.d.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openapi",
    "typescript",
    "api",
    "devpulse",
    "contracts",
    "types"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devpulse-dev/devpulse-oas.git",
    "directory": "api-types"
  },
  "author": "DevPulse Team",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.0"
  }
}
